# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sunucu tarafı — yalnızca platform kullanıcı listesi (auth.admin) için; istemciye koymayın
# SUPABASE_SERVICE_ROLE_KEY=

# Opsiyonel — e-posta sıfırlama yönlendirme URL doğrulaması için
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Haritalar vitrin yorumları (Places API — Platform → Google yorumları)
# GOOGLE_PLACES_API_KEY=

# Medya kütüphanesi (Netlify Blobs) — yerel geliştirmede netlify dev veya:
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
